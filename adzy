#!/usr/bin/env bash
set -euo pipefail

# Working from the inside out:

# - $0 — the path used to invoke the script (e.g., /Users/max/Documents/Work/mosaic-workspace/mos or just mos)
# - realpath "$0" — resolves to the absolute path, following symlinks (e.g., /Users/max/Documents/Work/mosaic-workspace/mos)
# - dirname "..." — strips the filename, keeping just the directory (e.g., /Users/max/Documents/Work/mosaic-workspace)
# - export — makes it available to child processes, not just this shell

# So WORKSPACE_ROOT = the directory where the mos file lives, no matter where you call it from.
export WORKSPACE="$(dirname "$(realpath "$0")")"
export CONFIG_ROOT="$WORKSPACE/.config"
export SCRIPTS_ROOT="$CONFIG_ROOT/scripts"

# Removes $1 from the argument list. Everything shifts down:

# Takes the command as the first argument, or defaults to "help" if no command is provided.
command="${1:-help}"

# - Before: $1=pod, $2=mosaic-staging, $3=mosaic-deployment
# - After shift: $1=mosaic-staging, $2=mosaic-deployment

# This way, when the subscript runs, $1 is its first real argument, not the command name.
shift 

script="${SCRIPTS_ROOT}/${command}.sh"

if [[ -f "$script" ]]; then
  . "$script"
else
  echo "Unknown command: $command"
  exit 1
fi
